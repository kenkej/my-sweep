#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ext_power.h>

#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5
#define L6 6
#define L7 7

// 34-key (3x5+2) position map for the Ferris Sweep / cradio shield.
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33
#define THUMBS 30 31 32 33

/ {
  macros {
    globe_a: globe_a {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&macro_press &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT>
        , <&macro_tap &kp A>
        , <&macro_release &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT>;
    };

    globe_n: globe_n {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings
        = <&macro_press &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT>
        , <&macro_tap &kp N>
        , <&macro_release &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    /**
     * Alpha layer (L0)
     *
     * Thumbs (4): the Corne's outer-left CAPS and the right-middle &mo L4 are
     * dropped here -- the Sweep only has two thumb keys per side. CAPS now
     * lives on L2 (bottom row, far right); L4 is entered from L2's outer-right
     * thumb, or from L7.
     */
    layer_0 {
      label = "ALPHA";
      bindings = <
        &kp Q     &kp W       &kp E       &kp R        &kp T       &kp Y      &kp U        &kp I       &kp O       &kp P
        &kp A     &kp S       &kp D       &kp F        &kp G       &kp H      &kp J        &kp K       &kp L       &lt L5 RET
        &kp Z     &kp X       &kp C       &kp V        &kp B       &kp N      &kp M        &kp COMMA   &kp DOT     &kp FSLH
                                          &mo L3       &mo L1      &lt L2 SPACE &mo 4
      >;
    };

    /**
     * Symbols layer (L1)
     *
     * Held with the left inner thumb. The Corne's outer-right &sl L3 is dropped
     * (redundant: &mo L3 sits on the left outer thumb of this same layer).
     */
    layer_1 {
      label = "RAISE";
      bindings = <
        &kp N1     &kp N2    &kp N3    &kp N4     &kp N5     &kp N6    &kp N7    &kp N8     &kp N9     &kp N0
        &kp TAB    &kp LALT  &kp LCMD  &kp LCTRL  &kp DEL    &kp BSPC  &kp SEMI  &kp SQT    &kp BSLH   &kp EQUAL
        &kp LSHIFT &kp LG(X) &kp LG(C) &kp LG(V)  &kp LBKT   &kp RBKT  &kp C_PP  &kp C_PREV &kp C_NEXT &kp FSLH
                                       &mo L3     &none      &kp MINUS &kp LSHIFT
      >;
    };

    /**
     * Number and directions layer (L2)
     *
     * Held with the right inner thumb. &mo L4 moves from the Corne's right
     * middle thumb to the right outer thumb; &sl L3 is dropped (redundant with
     * &mo L3 on the left outer thumb). &kp CAPS lands on the bottom row, far
     * right, replacing a duplicate &kp LSHIFT.
     */
    layer_2 {
      label = "LOWER";
      bindings = <
        &kp GRAVE  &kp LG(GRAVE) &kp LG(TAB)  &kp LC(N4)   &kp LC(N5)   &kp LC(N6) &caps_word &kp LG(TAB)       &kp LG(GRAVE)   &kp ESC
        &kp TAB    &kp LALT      &kp LCMD     &kp LCTRL    &kp LG(N5)   &kp LEFT   &kp DOWN   &kp UP            &kp RIGHT       &mo L7
        &kp LSHIFT &bt BT_CLR    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &to L6     &kp C_MUTE &kp C_VOLUME_DOWN &kp C_VOLUME_UP &kp GRAVE
                                              &mo L3       &mo L1       &kp SPACE  &mo L4
      >;
    };

    /**
     * Controls homerow mod (L3)
     *
     * Held with the left outer thumb.
     */
    layer_3 {
      label = "HOMEROW";
      bindings = <
        &kp Q     &kp W     &kp E     &kp R     &kp T      &kp Y     &kp U     &kp I     &kp O    &kp P
        &kp A     &kp LALT  &kp LCMD  &kp LCTRL &kp LBKT   &kp H     &kp J     &kp K     &kp L    &kp RET
        &kp LSHFT &kp X     &globe_a  &globe_n  &kp B      &kp N     &kp M     &kp COMMA &kp DOT  &kp SLASH
                                      &none     &kp LSHFT  &kp SPACE &to L0
      >;
    };

    /**
     * Controls homerow mod (L4)
     *
     * Reached from L2 (outer right thumb) or L7.
     */
    layer_4 {
      label = "HOMEROW";
      bindings = <
        &kp Q     &kp W     &kp E     &kp R     &kp T      &kp Y     &kp U     &kp I     &kp O    &kp LBKT
        &kp A     &kp S     &kp D     &kp F     &kp G      &kp RBKT  &kp LCTRL &kp LCMD  &kp LALT &kp RET
        &kp Z     &kp X     &kp C     &kp V     &kp B      &kp N     &kp M     &kp COMMA &kp DOT  &kp LSHFT
                                      &kp BSPC  &kp LSHFT  &kp SPACE &to L0
      >;
    };

    /**
     * Mouse layer (L5) -- held with &lt L5 RET on the right home row.
     */
    layer_5 {
      label = "MOUSE";
      bindings = <
        &mkp LCLK      &mmv MOVE_UP   &mkp RCLK       &msc SCRL_UP    &kp T      &kp Y     &kp U     &kp I     &kp O    &kp LBKT
        &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_DOWN  &kp G      &kp RBKT  &kp LCTRL &kp LCMD  &kp LALT &kp RET
        &kp Z          &kp X          &kp C           &kp V           &kp B      &kp N     &kp M     &kp COMMA &kp DOT  &kp LSHFT
                                                      &kp BSPC        &kp LSHFT  &kp SPACE &to L0
      >;
    };

    /**
     * Gaming layer (L6)
     *
     * The Corne's left outer thumb (&kp G) is dropped; &to L0 is kept on the
     * right outer thumb as the only way back out of this layer.
     */
    layer_6 {
      label = "GAMING";
      bindings = <
        &kp TAB     &kp Q     &kp W     &kp E     &kp R       &kp Y        &kp U      &kp I     &kp O   &kp P
        &kp LSHIFT  &kp A     &kp S     &kp D     &kp F       &kp H        &kp J      &kp K     &kp L   &lt L5 RET
        &kp LCTRL   &kp Z     &kp X     &kp C     &kp V       &kp N        &kp M      &kp COMMA &kp DOT &kp FSLH
                                        &kp Y     &kp T       &lt L2 SPACE &to L0
      >;
    };

    /**
     * Function layer (L7) -- held with &mo L7 on L2.
     *
     * &sl L3 is dropped (redundant with &mo L3 on the left outer thumb); &mo L4
     * moves to the right outer thumb.
     */
    layer_7 {
      label = "FUNCTION";
      bindings = <
        &kp F1     &kp F2    &kp F3    &kp F4     &kp F5     &kp F6    &kp F7   &kp F8     &kp F9     &kp F10
        &kp TAB    &kp LALT  &kp LCMD  &kp LCTRL  &kp DEL    &kp BSPC  &kp F11  &kp F12    &kp BSLH   &kp EQUAL
        &kp LSHIFT &kp LG(X) &kp LG(C) &kp LG(V)  &kp LBKT   &kp RBKT  &kp C_PP &kp C_PREV &kp C_NEXT &kp FSLH
                                       &mo L3     &none      &kp MINUS &mo L4
      >;
    };
  };
};
